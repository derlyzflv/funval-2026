              "xml": {
                "name": "main"
              }
            }
          },
          "404": {
            "description": "Producto no encontrado"
          },
          "500": {
            "description": "Error al obtener el producto"
          }
        }
      },
      "put": {
        "tags": [
          "Menu"
        ],
        "summary": "Actualizar un producto",
        "description": "Actualiza los datos de un producto existente según su ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "ID numérico del producto",
            "minimum": 1,
            "example": 1
          },
          {
            "name": "body",
            "in": "body",
            "description": "Datos actualizados del producto",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Chaufa de Pollo"
                },
                "description": {
                  "type": "string",
                  "example": "Arroz frito al wok con trozos de pollo, huevo, cebolla china y sillao"
                },
                "price": {
                  "type": "number",
                  "example": 15
                },
                "stock": {
                  "type": "number",
                  "example": 127
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Producto actualizado correctamente",
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "number",
                  "example": 1
                },
                "name": {
                  "type": "string",
                  "example": "Chaufa de Pollo"
                },
                "description": {
                  "type": "string",
                  "example": "Arroz frito al wok con trozos de pollo, huevo, cebolla china y sillao"
                },
                "price": {
                  "type": "string",
                  "example": "15.00"
                },
                "stock": {
                  "type": "number",
                  "example": 127
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "400": {
            "description": "Error de validación en los datos enviados"
          },
          "404": {
            "description": "Producto no encontrado"
          },
          "500": {
            "description": "Error al actualizar el producto"
          }
        }
      }
    },
